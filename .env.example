# 服务器端口
PORT=3000

# 允许的跨域域名（多个域名用逗号分隔）
# 留空或设置为 * 表示允许所有域名访问
# 示例: ALLOW_ORIGIN=https://example.com,https://api.example.com
ALLOW_ORIGIN=

# 开放的服务，设置为 open 表示开启，留空或设置为其他值均为关闭
MUSIC=open
AVATAR=open
EMOJI=open


# ===== 管理后台 /admin =====
# 管理员密码（明文，优先级最高；留空则首次在本机/内网访问 /admin 时初始化）
ADMIN_PASSWORD=
# 或使用 scrypt 哈希（格式: scrypt$salt$hash），与 ADMIN_PASSWORD 二选一即可
ADMIN_PASSWORD_HASH=
# 会话签名密钥，留空会自动生成并保存到 data/config/admin.json
ADMIN_SESSION_SECRET=
# 会话有效期（分钟）
ADMIN_SESSION_TTL=120
# 是否允许从公网完成首次密码初始化（默认仅本机/内网）
ADMIN_SETUP_REMOTE=false
