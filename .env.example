# ===== 基础 =====
# 服务器端口
PORT=3000

# 数据目录（配置、统计、会话密钥）；默认 ./data
DATA_DIR=./data

# 静态资源目录；默认 ./public
PUBLIC_DIR=./public

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 允许的跨域域名（多个域名用逗号分隔）
# 留空或设置为 * 表示允许所有域名访问公开接口
# 公开接口不使用 Cookie；后台接口不挂 CORS
# 示例: ALLOW_ORIGIN=https://example.com,https://api.example.com
ALLOW_ORIGIN=

# 开放的服务，设置为 open 表示开启，留空或设置为其他值均为关闭
MUSIC=open
AVATAR=open
EMOJI=open

# ===== 反向代理 =====
# 是否信任反向代理传来的客户端 IP 头（X-Forwarded-For / X-Real-IP）
# 默认关闭；直接暴露到公网时不要开启
TRUST_PROXY=false

# 可信代理地址，多个用逗号分隔（如 127.0.0.1）
# 配置后只接受这些代理的连接；为空且 TRUST_PROXY=true 时信任所有代理
TRUSTED_PROXIES=

# 是否信任 Cloudflare 的 CF-Connecting-IP（仅使用 Cloudflare 时开启）
TRUST_CLOUDFLARE=false

# 对外访问地址（如 https://api.example.com）
# 用于生成绝对地址和后台同源校验；反向代理改写 Host 时建议设置
PUBLIC_ORIGIN=

# ===== 管理后台 /admin =====
# 管理员密码（明文，优先级最高；留空则首次在本机/内网访问 /admin 时初始化）
ADMIN_PASSWORD=
# 或使用 scrypt 哈希（格式: scrypt$salt$hash），与 ADMIN_PASSWORD 二选一即可
ADMIN_PASSWORD_HASH=
# 会话签名密钥，留空会自动生成并保存到 data/config/admin.json
ADMIN_SESSION_SECRET=
# 会话有效期（分钟，最长 10080）
ADMIN_SESSION_TTL=120
# 是否允许从公网完成首次密码初始化（默认仅本机/内网）
ADMIN_SETUP_REMOTE=false
# 首次初始化令牌；留空会随机生成并打印到服务端日志
ADMIN_SETUP_TOKEN=